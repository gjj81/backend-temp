<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mes.mapper.BaseWorkshopMapper">

    <resultMap id="BaseResultMap" type="mes.entity.BaseWorkshop">
            <id property="workshopId" column="workshop_id" />
            <result property="workshopCode" column="workshop_code" />
            <result property="workshopName" column="workshop_name" />
            <result property="status" column="status" />
            <result property="deleted" column="deleted" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        workshop_id,workshop_code,workshop_name,status,deleted,create_time,
        update_time
    </sql>
    <select id="list" resultType="mes.vo.base.WorkshopVO">
        select workshop_id,workshop_code,workshop_name
        from base_workshop
        where deleted = 0
        and status = 1
    </select>

</mapper>
